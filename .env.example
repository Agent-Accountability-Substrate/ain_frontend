# Auth.js + Auth0 (generic OIDC). Copy to .env.local and fill from the Auth0
# application's Settings tab. .env.local is git-ignored — never commit real values.

# Auth0 "Regular Web App" credentials
AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=
# Full issuer URL: https:// + your Auth0 domain, no trailing path.
# e.g. https://your-tenant.uk.auth0.com
AUTH_AUTH0_ISSUER=

# Session-cookie encryption secret (min 32 chars). Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# The app's external origin. REQUIRED in every deployed environment and MUST be
# https:// — TLS terminates at the reverse proxy (Coolify/Traefik) so the
# container sees http; without this pin, Auth.js writes session cookies WITHOUT
# the Secure flag. Boot fails closed if it is unset in production.
# Local http dev may leave it unset.
#   e.g. AUTH_URL=https://ain.example.com
AUTH_URL=
